# Build context for docker/node/Dockerfile. The development target copies no
# application source (it is bind-mounted); the production target builds from
# it. Secrets, local state and generated files never enter an image.
.git
.env
.env.*
node_modules
.next
out
coverage
playwright-report
test-results
*.tsbuildinfo
next-env.d.ts
tmp
*.log
**/*.test.ts
**/*.test.tsx
src/test
vitest.config.mts
vitest.setup.ts
