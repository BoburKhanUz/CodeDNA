# =============================================================================
# CodeDNA — production environment TEMPLATE (Phase 25)
# =============================================================================
# Copy OUTSIDE the repository (e.g. /etc/codedna/production.env, mode 0600,
# owned by the deploying user) and fill in every [required] value there:
#
#   docker compose -f docker-compose.prod.yml --env-file /etc/codedna/production.env config --quiet
#
# Never commit a filled-in copy. Secret-like values are intentionally EMPTY
# here (scripts/check_repo.py enforces it); generate them as documented in
# docs/operations/production-configuration.md. Values the deployment must
# never change (APP_ENV=production, APP_DEBUG=false, secure cookies, trusted
# proxies, gVisor evaluator isolation, ...) are fixed in docker-compose.prod.yml.

# --- Release and domain ------------------------------------------------------
# [required] Release identifier: image tag and the version /api/v1/health reports.
APP_VERSION=
# [required] Public hostname, lowercase, no scheme (e.g. app.example.com).
CODEDNA_DOMAIN=
# [required] Paths, on the Docker host, to the PEM certificate chain and key.
TLS_CERTIFICATE_FILE=
TLS_PRIVATE_KEY_FILE=
# [optional] Published ports and bind address.
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_BIND_ADDRESS=0.0.0.0
# [optional] Image name prefix (e.g. a private registry path).
CODEDNA_IMAGE_PREFIX=codedna

# --- Application -------------------------------------------------------------
# [required][secret] "base64:" + 32 random bytes. Generate once, keep forever
# (rotating it logs everyone out and breaks encrypted values).
APP_KEY=
# [optional] info (default), notice, warning, error. Never debug.
LOG_LEVEL=info

# --- PostgreSQL --------------------------------------------------------------
# [optional] Defaults to the bundled postgres service.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=codedna
DB_USERNAME=codedna
# [required][secret]
DB_PASSWORD=
# [optional] prefer (bundled, private network) | require | verify-full (managed
# database). A DB_HOST that is not an internal service name requires require,
# verify-ca or verify-full (docker/enterprise/compose.external-postgres.yml).
DB_SSLMODE=prefer
# [optional] Keep each PHP-FPM worker's database connection open (default true;
# see docs/performance/database-performance.md#connections).
DB_PERSISTENT=true

# --- Redis -------------------------------------------------------------------
# [optional] Defaults to the bundled redis service. A customer-run Redis
# (docker/enterprise/compose.external-redis.yml) needs REDIS_SCHEME=tls.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SCHEME=
# [required][secret]
REDIS_PASSWORD=
# [optional] Memory ceiling (no eviction: writes fail loudly at the limit).
REDIS_MAXMEMORY=384mb

# --- Sessions and CORS -------------------------------------------------------
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
# [optional] Extra exact https origins allowed to call the API with
# credentials. Empty (default) = same origin only.
CORS_ALLOWED_ORIGINS=

# --- Object storage ----------------------------------------------------------
# [optional] Empty = the bundled private MinIO (http://minio:9000). An
# external S3-compatible provider must use https.
SOURCE_STORAGE_ENDPOINT=
SOURCE_STORAGE_REGION=us-east-1
SOURCE_STORAGE_BUCKET=codedna
SOURCE_STORAGE_USE_PATH_STYLE=true
# [required][secret] Bucket-scoped application credentials.
SOURCE_STORAGE_ACCESS_KEY_ID=
SOURCE_STORAGE_SECRET_ACCESS_KEY=
SOURCE_STORAGE_PREFIX=
# [required][secret] Bundled MinIO administrator (used only by minio-init).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# [optional] Hostnames pre-signed source URLs may use (the storage host).
ANALYZER_ALLOWED_SOURCE_HOSTS=minio
ANALYZER_LOCAL_SOURCE_HOSTS=minio

# --- Analyzer ----------------------------------------------------------------
# [required][secret] At least 32 characters (64 hex recommended).
ANALYZER_HMAC_SECRET=
# [optional][secret] The previous secret, during a rotation only.
ANALYZER_HMAC_SECRET_PREVIOUS=
# [optional] Analyses at once (analyzer slots, shared by every queue worker)
# and how long a worker waits for one (docs/performance/scaling-guide.md).
ANALYZER_MAX_CONCURRENCY=2
ANALYZER_SLOT_WAIT_SECONDS=20

# --- GitHub App [optional: all or nothing] ------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# [secret]
GITHUB_APP_CLIENT_SECRET=
# [secret] PEM private key (newlines as \n).
GITHUB_APP_PRIVATE_KEY=

# --- GitLab [optional: ID and secret together] -------------------------------
# OAuth application, scope read_api, redirect URI https://<domain>/app/integrations/gitlab/callback.
GITLAB_CLIENT_ID=
# [secret]
GITLAB_CLIENT_SECRET=
# GitLab.com or a self-managed instance (https, no query string).
GITLAB_BASE_URL=https://gitlab.com

# --- Bitbucket Cloud [optional: ID and secret together] ----------------------
# OAuth consumer with Account: Read and Repositories: Read, callback
# https://<domain>/app/integrations/bitbucket/callback.
BITBUCKET_CLIENT_ID=
# [secret]
BITBUCKET_CLIENT_SECRET=

# --- AI interpretation and insights [optional] --------------------------------
# Local Ollama by default: start it with --profile local-ai and pull the model
# explicitly (docs/operations/local-ai.md). A remote endpoint needs https and
# AI_ALLOW_REMOTE_ENDPOINT=true.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=qwen2.5-coder:7b
AI_BASE_URL=http://ollama:11434
AI_ALLOW_REMOTE_ENDPOINT=false
# [secret] only for a remote endpoint behind an authenticating proxy.
AI_API_KEY=
AI_TIMEOUT_SECONDS=120
AI_JOB_TIMEOUT_SECONDS=180
# The model's context window, default 8192: AI_CONTEXT_TOKENS (Ollama num_ctx).
AI_MAX_CONCURRENCY=1
# Resources of the optional Ollama container.
OLLAMA_MEM_LIMIT=12g
OLLAMA_CPUS=4

# --- Coding challenges ---------------------------------------------------------
# spool (requires the gVisor runtime on the host) | none (execution disabled).
CHALLENGE_ENABLED=true
CHALLENGE_EVALUATOR=spool
# [optional] Name of the registered gVisor runtime (default runsc).
EVALUATOR_RUNTIME=runsc

# --- Registration and edition (Phase 27, docs/enterprise/) ---------------------
# open (anyone may create an account) | restricted (only the email domains
# below) | closed (no new accounts).
REGISTRATION_MODE=open
# [restricted only] Comma-separated domains, e.g. example.com,example.org.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=
# [optional] Path on the host to the signed enterprise license file
# (docs/enterprise/licensing.md). Empty = Community edition.
CODEDNA_LICENSE_FILE=
