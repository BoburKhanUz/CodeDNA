# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,css,scss,yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Trailing double-space is a Markdown line break; keep files explicit instead.
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.{neon,neon.dist}]
indent_style = tab
