<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        Variables are <server> entries with force="true": the backend container
        already exports the development values (e.g. DB_DATABASE=codedna), and
        Laravel reads $_SERVER before $_ENV, so plain <env> entries would lose.
        Tests must never touch the development database; tests/TestCase.php
        additionally refuses to run against a database whose name does not
        end in "_test".
    -->
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_DEBUG" value="false" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <!-- PostgreSQL: dedicated test database (created by `make test`). -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="codedna_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <!-- Fast in-memory drivers by default; infrastructure tests use Redis explicitly. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <!-- Redis: databases reserved for tests (development uses 0 and 1). -->
        <server name="REDIS_DB" value="14" force="true"/>
        <server name="REDIS_CACHE_DB" value="15" force="true"/>
        <server name="REDIS_PREFIX" value="codedna-test-" force="true"/>
        <server name="SANCTUM_STATEFUL_DOMAINS" value="localhost" force="true"/>
        <server name="CORS_ALLOWED_ORIGINS" value="" force="true"/>
        <server name="SESSION_SECURE_COOKIE" value="false" force="true"/>
        <!-- Storage tests use the real MinIO bucket under this prefix; each test adds its own unique sub-prefix and deletes it. -->
        <server name="SOURCE_STORAGE_PREFIX" value="phpunit/" force="true"/>
    </php>
</phpunit>
