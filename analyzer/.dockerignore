# Build context for docker/python/Dockerfile. Only the requirement files are
# needed by the development target (source is bind-mounted); the production
# target also copies app/. Tests and caches never enter an image.
.git
.env
.env.*
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
.coverage
htmlcov
coverage
tmp
*.log
tests
