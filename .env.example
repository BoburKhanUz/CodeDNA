# =============================================================================
# CodeDNA — environment variables (template)
# =============================================================================
# Copy to `.env` for local development:   cp .env.example .env
#
# Rules:
#   * Never commit `.env` or any real value of a secret.
#   * Secret-like variables (PASSWORD, SECRET, TOKEN, *_KEY, DSN) MUST stay
#     empty in this file; `scripts/check_repo.py` enforces this in CI.
#   * Variables marked [Phase NN] are not used by anything yet; they document
#     the planned configuration surface.
#
# Phase 01: only the PostgreSQL and Redis containers in docker-compose.yml
# consume variables from this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=codedna

# -----------------------------------------------------------------------------
# PostgreSQL 16 (used now by docker-compose.yml; by Laravel from Phase 03)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=codedna
DB_USERNAME=codedna
# Required. Choose a local-only password; never reuse it elsewhere.
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis 7 (used now by docker-compose.yml; by Laravel from Phase 03)
# Local Redis listens on 127.0.0.1 only and has no password.
# Production MUST set a password/ACL.
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Laravel application [Phase 03]
# -----------------------------------------------------------------------------
APP_NAME=CodeDNA
APP_ENV=local
# Generated by `php artisan key:generate`; never commit.
APP_KEY=
APP_DEBUG=true
# Public origin. Single-origin topology via Nginx (ADR-006).
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=debug

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# -----------------------------------------------------------------------------
# Sessions / Sanctum SPA authentication [Phase 06] (ADR-006)
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Leave empty for host-only cookies (single origin). Set the parent domain only
# for the split-origin fallback.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000

# -----------------------------------------------------------------------------
# Next.js frontend [Phase 04]
# -----------------------------------------------------------------------------
# Server-side base URL for Laravel (never exposed to the browser).
BACKEND_INTERNAL_URL=http://nginx

# -----------------------------------------------------------------------------
# Source storage — S3-compatible API [Phase 07] (ADR-003)
# Production: Cloudflare R2. Local emulator: chosen in Phase 02.
# For R2: endpoint is https://<account-id>.r2.cloudflarestorage.com, region "auto".
# -----------------------------------------------------------------------------
SOURCE_STORAGE_ENDPOINT=
SOURCE_STORAGE_REGION=auto
SOURCE_STORAGE_BUCKET=codedna-sources
SOURCE_STORAGE_USE_PATH_STYLE=true
SOURCE_STORAGE_ACCESS_KEY_ID=
SOURCE_STORAGE_SECRET_ACCESS_KEY=
# Lifetime of pre-signed GET URLs handed to the analyzer.
SOURCE_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Analyzer — shared by Laravel (client) and analyzer (server) [Phases 08/10]
# See docs/api/internal-analyzer-contract.md
# -----------------------------------------------------------------------------
# Internal URL only; the analyzer is never publicly exposed.
ANALYZER_URL=http://analyzer:8000
# >= 32 random bytes (hex or base64). Same value on both sides.
ANALYZER_HMAC_SECRET=
# Only set during secret rotation.
ANALYZER_HMAC_SECRET_PREVIOUS=

# Laravel side
ANALYZER_CONNECT_TIMEOUT_SECONDS=5
ANALYZER_TIMEOUT_SECONDS=300
ANALYZER_MAX_ATTEMPTS=3

# Analyzer side (invariant: hard timeout < ANALYZER_TIMEOUT_SECONDS)
ANALYZER_HARD_TIMEOUT_SECONDS=240
ANALYZER_MAX_CONCURRENCY=2
# Comma-separated hostnames the analyzer may download source archives from.
ANALYZER_ALLOWED_SOURCE_HOSTS=
ANALYZER_MAX_ARCHIVE_BYTES=52428800
ANALYZER_MAX_EXTRACTED_BYTES=209715200
ANALYZER_MAX_FILES=20000
ANALYZER_MAX_FILE_BYTES=1048576

# -----------------------------------------------------------------------------
# GitHub integration [Phase 19]
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# -----------------------------------------------------------------------------
# AI interpretation [Phase 15] — receives derived metrics only, never source
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# -----------------------------------------------------------------------------
# Error tracking [later]
# -----------------------------------------------------------------------------
SENTRY_DSN=
