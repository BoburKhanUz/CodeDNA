# =============================================================================
# CodeDNA — environment variables (template)
# =============================================================================
# Quick start:   make setup      (copies this file to .env and generates the
#                                 local secrets marked [generated] below)
# Manual:        cp .env.example .env   and fill in every [required] value.
#
# Rules:
#   * Never commit `.env` or any real secret value.
#   * Secret-like variables (PASSWORD, SECRET, TOKEN, *_KEY, *_KEY_ID, DSN)
#     MUST stay empty in this file; `scripts/check_repo.py` enforces it in CI.
#   * Inside Docker, services reach each other by service name (postgres,
#     redis, minio, analyzer); those hostnames are set in docker-compose.yml,
#     not here.
#   * Variables marked [Phase NN] are not used yet; they document the planned
#     configuration surface.
#
# Full reference: docs/architecture/infrastructure.md#environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose / host
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=codedna
# UID/GID of your host user, so files created in bind mounts stay yours.
# [generated] by `make setup` from `id -u` / `id -g`.
HOST_UID=
HOST_GID=

# Host ports (all bound to 127.0.0.1). If you change NGINX_HOST_PORT, also
# change APP_URL / FRONTEND_URL (e.g. http://localhost:8080).
NGINX_HOST_PORT=80
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# -----------------------------------------------------------------------------
# Laravel application (backend container)
# -----------------------------------------------------------------------------
APP_NAME=CodeDNA
APP_ENV=local
# [required][generated] "base64:" + 32 random bytes. Never commit.
APP_KEY=
APP_DEBUG=true
# Public single origin served by Nginx (ADR-006).
APP_URL=http://localhost
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
DB_DATABASE=codedna
DB_USERNAME=codedna
# [required][generated] Local-only password.
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis 7 — no password locally (bound to 127.0.0.1, internal network).
# Production MUST use a password/ACL.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# MinIO (local S3-compatible storage). Root credentials are used ONLY by the
# MinIO server and the one-shot `minio-init` container — never by the app.
# Console: http://localhost:9001
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=codedna-admin
# [required][generated] At least 8 characters.
MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Source storage — provider-neutral S3 settings used by the application
# (ADR-003). Locally: MinIO, bucket-scoped user created by `minio-init`.
# Production: Cloudflare R2 (endpoint https://<account-id>.r2.cloudflarestorage.com,
# region "auto"). The endpoint is fixed to http://minio:9000 in
# docker-compose.yml for local development.
# -----------------------------------------------------------------------------
SOURCE_STORAGE_REGION=us-east-1
SOURCE_STORAGE_BUCKET=codedna
# [required][generated] Application access key (min 3 chars) and secret (min 8 chars).
SOURCE_STORAGE_ACCESS_KEY_ID=
SOURCE_STORAGE_SECRET_ACCESS_KEY=
# [Phase 07] Lifetime of pre-signed GET URLs handed to the analyzer.
SOURCE_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Analyzer — shared by Laravel (client) and analyzer (server) [Phases 08/10]
# The URL is fixed to http://analyzer:8000 in docker-compose.yml.
# See docs/api/internal-analyzer-contract.md
# -----------------------------------------------------------------------------
# [generated] >= 32 random bytes, same value on both sides. Unused until Phase 08.
ANALYZER_HMAC_SECRET=
# Only set during secret rotation.
ANALYZER_HMAC_SECRET_PREVIOUS=
ANALYZER_CONNECT_TIMEOUT_SECONDS=5
ANALYZER_TIMEOUT_SECONDS=300
ANALYZER_MAX_ATTEMPTS=3
ANALYZER_HARD_TIMEOUT_SECONDS=240
ANALYZER_MAX_CONCURRENCY=2
# Hostnames the analyzer may download source archives from (local: minio).
ANALYZER_ALLOWED_SOURCE_HOSTS=minio
ANALYZER_MAX_ARCHIVE_BYTES=52428800
ANALYZER_MAX_EXTRACTED_BYTES=209715200
ANALYZER_MAX_FILES=20000
ANALYZER_MAX_FILE_BYTES=1048576

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Set to true if hot reload misses file changes (some Docker Desktop setups).
FRONTEND_WATCH_POLLING=false
# [Phase 04] Public origin and server-side base URL for Laravel (never exposed
# to the browser).
FRONTEND_URL=http://localhost
BACKEND_INTERNAL_URL=http://nginx

# -----------------------------------------------------------------------------
# Sessions / Sanctum SPA authentication [Phase 06] (ADR-006)
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Leave empty for host-only cookies (single origin).
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
# localhost = Docker single origin; localhost:3000 = native split-origin fallback.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# -----------------------------------------------------------------------------
# GitHub integration [Phase 19]
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# -----------------------------------------------------------------------------
# AI interpretation [Phase 15] — receives derived metrics only, never source
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# -----------------------------------------------------------------------------
# Error tracking [later]
# -----------------------------------------------------------------------------
SENTRY_DSN=
