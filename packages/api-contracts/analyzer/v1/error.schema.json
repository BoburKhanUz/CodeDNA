{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codedna.dev/contracts/analyzer/v1/error.schema.json",
  "title": "Analyzer error envelope (contract 1.0, section 5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "request_id"],
      "properties": {
        "code": {
          "enum": [
            "UNSUPPORTED_CONTRACT_VERSION", "INVALID_SIGNATURE", "STALE_TIMESTAMP", "REPLAY_DETECTED",
            "NOT_FOUND", "METHOD_NOT_ALLOWED", "RUN_IN_PROGRESS", "RUN_CONFLICT", "SOURCE_TOO_LARGE",
            "TOO_MANY_FILES", "INVALID_REQUEST", "SOURCE_HOST_NOT_ALLOWED", "SOURCE_URL_EXPIRED",
            "SOURCE_CHECKSUM_MISMATCH", "INVALID_ARCHIVE", "NO_SUPPORTED_FILES", "SOURCE_FETCH_FAILED",
            "ANALYZER_BUSY", "ANALYSIS_TIMEOUT", "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "request_id": { "type": ["string", "null"] },
        "details": { "type": "object" }
      }
    }
  }
}
